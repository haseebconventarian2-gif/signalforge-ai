# Application
APP_ENVIRONMENT=development
APP_NAME=SignalForge API
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Exact frontend origins allowed to call the API and WebSocket, comma-separated.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# PostgreSQL
POSTGRES_DB=signalforge
POSTGRES_USER=signalforge
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+asyncpg://signalforge:replace-with-a-local-password@localhost:5432/signalforge
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
# Set true only for Supabase transaction mode (port 6543); disables client pooling/prepared cache.
DATABASE_TRANSACTION_POOLER=false

# Alpaca PAPER TRADING ONLY. This exact trading URL is enforced at startup.
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_LIVE_TRADE=false

# Orders remain disabled until the guarded execution phase is implemented.
ORDER_SUBMISSION_ENABLED=false
ALPACA_REQUEST_TIMEOUT_SECONDS=15
ALPACA_MAX_SAFE_RETRIES=3
ALPACA_RETRY_BASE_SECONDS=0.25
ALPACA_STOCK_FEED=iex
ALPACA_OPTION_FEED=indicative

# Phase 3 deterministic daily market scan
MARKET_WATCHLIST=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMD,TSLA,META,AMZN,GOOGL,NFLX,AVGO,JPM,BAC,XOM,COIN,PLTR,INTC,TLT
MARKET_SCAN_LOOKBACK_DAYS=180
MARKET_MAX_DATA_AGE_SECONDS=345600
OPPORTUNITY_SIGNAL_THRESHOLD=0.35
OPPORTUNITY_MIN_VOLUME_RATIO=0.75

# Phase 4 OpenAI reasoning. The model is advisory and cannot execute orders.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Azure OpenAI: set both values to route through your Azure resource.
# OPENAI_API_KEY remains the Azure resource key in this mode.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
OPENAI_MAX_INPUT_CHARS=12000

# Deterministic risk limits (fractions: 0.01 = 1%)
RISK_MAX_RISK_PER_TRADE_PCT=0.0075
RISK_MAX_PREMIUM_PER_TRADE=750
RISK_MAX_PORTFOLIO_EXPOSURE_PCT=0.05
RISK_MAX_OPEN_POSITIONS=4
RISK_MAX_UNDERLYING_EXPOSURE_PCT=0.015
RISK_MIN_AI_CONFIDENCE=0.72
RISK_MAX_DAILY_LOSS_PCT=0.02
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_COOLDOWN_MINUTES=30
RISK_MAX_QUOTE_AGE_SECONDS=15
RISK_MIN_VOLUME_RATIO=0.75
RISK_MAX_BID_ASK_SPREAD_PCT=0.15
RISK_MIN_DTE=7
RISK_MAX_DTE=35
RISK_KILL_SWITCH=false

# Contract selection and exits
OPTION_TARGET_DTE=21
OPTION_MAX_STRIKE_DISTANCE_PCT=0.10
OPTION_MIN_BID_SIZE=1
OPTION_MIN_ASK_SIZE=1
EXIT_STOP_LOSS_PCT=0.35
EXIT_TAKE_PROFIT_PCT=0.60
EXIT_MAX_HOLDING_DAYS=10
EXIT_DTE=2

# Autonomy remains disabled until explicitly reviewed.
AGENT_SCAN_INTERVAL_SECONDS=300
AGENT_AUTONOMY_ENABLED=false
DEMO_MODE=false
# Required for every agent mutation endpoint. Use at least 32 random characters.
CONTROL_API_TOKEN=
ALPACA_CLI_EXECUTABLE=alpaca
ALPACA_CLI_TIMEOUT_SECONDS=10
